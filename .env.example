# Trakos — Environment Variables
# Copy this to .env and fill in your values

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# Google service account JSON (paste the entire JSON as one line)
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"..."}

# Google Sheet ID (from the sheet URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit)
SHEET_ID=your_sheet_id_here

# Your Telegram user ID (for security — only you can use the bot)
# Send /start to @userinfobot on Telegram to get your ID
ALLOWED_USER_IDS=your_telegram_user_id

# Existing Groq integration for manually typed expenses only
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Enable only after adding a persistent Railway Volume at /data.
SMS_IMPORT_ENABLED=0
TRAKOS_DB_PATH=/data/trakos.sqlite3
SMS_OWNER_USER_ID=
# Share this Drive folder with the service account as Viewer.
SMS_DRIVE_FOLDER_ID=
SMS_POLL_SECONDS=3600
